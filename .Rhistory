pres_ramo <- function(anio_sel, ramo_sel) {
inv_fed %>%
filter(ciclo == anio_sel, id_ramo == ramo_sel) %>%
pull(if_else(anio_sel == 2025, p_aprobado, p_ejercido)) %>%
sum(na.rm = T)
}
pres_ramo(2024, "10. Educación")
pres_ramo(2025, "10. Educación")
pres_ramo(2023, "10. Educación")
pres_ramo <- function(anio_sel, ramo_sel) {
inv_fed %>%
filter(ciclo == anio_sel, id_ramo == ramo_sel) %>%
pull(if (anio_sel == 2025) p_aprobado else p_ejercido) %>%
sum(na.rm = T)
}
pres_ramo(2023, "10. Educación")
pres_ramo(2023, "10. Economía")
pres_ramo(2023, "12. Salud")
proppres_ramo <- function(anio_sel, ramo_sel){
total <- inv_fed %>%
filter(ciclo == anio_sel) %>%
pull(if (anio_sel == 2025) p_aprobado else p_ejercido) %>%
sum(na.rm = T)
presupuesto <- inv_fed %>%
filter(ciclo == anio_sel, id_ramo == ramo_sel) %>%
pull(if (anio_sel == 2025) p_aprobado else p_ejercido) %>%
sum(na.rm = TRUE)
porcentaje <- percent(pp_ejercido/total_ejercido,
accuracy = 0.001)
return(porcentaje)
}
proppres_ramo(2024, "10. Economía")
proppres_ramo <- function(anio_sel, ramo_sel){
total <- inv_fed %>%
filter(ciclo == anio_sel) %>%
pull(if (anio_sel == 2025) p_aprobado else p_ejercido) %>%
sum(na.rm = T)
presupuesto <- inv_fed %>%
filter(ciclo == anio_sel, id_ramo == ramo_sel) %>%
pull(if (anio_sel == 2025) p_aprobado else p_ejercido) %>%
sum(na.rm = TRUE)
porcentaje <- percent(presupuesto/total,
accuracy = 0.001)
return(porcentaje)
}
proppres_ramo(2024, "10. Economía")
proppres_ramo(2024, "20. Bienestar")
proppres_ramo(2024, "12. Salud")
varpres_ramo <- function(anio_sel, ramo_sel) {
cicloprevio <- anio_sel -1
previo <- inv_fed %>%
filter(ciclo == cicloprevio, id_ramo == ramo_sel) %>%
pull(if (anio_sel == 2025) p_aprobado else p_ejercido) %>%
sum(na.rm = T)
actual <- pres_ramo(anio_sel, ramo_sel)
variacion <- (actual-previo)/previo
percent(variacion, accuracy = 0.01)
}
varpres_ramo(2024, "11. Educación Pública")
