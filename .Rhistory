bloque_info <- function(titulo, outputId, color = NULL, grosor = NULL) {
separador <- function() {
tags$div(style = paste0(
"border-top: ", ifelse(grosor = NULL, "2px", grosor), " solid ", color, "; width: 100%; margin: 1rem 0;"
))
}
tags$div(
titulo,
separador(),
tags$h4(
uiOutput(outputId),
style = paste0("color: ", ifelse(color = NULL, "#297272", NULL), "; font-weight: bold;")
)
)
}
